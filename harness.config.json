{
  "$schema": "./harness.schema.json",
  "project": "actas-reuniones",
  "language": "python",
  "description": "Actas de las reuniones de socios: supervisor del grabador (Chromium por CDP) y cliente de la plataforma de transcripción. Python 3.12 con uv; PostgreSQL efímero para los tests de integración (scripts/pg-pruebas.sh).",
  "commands": {
    "install": "uv sync --locked",
    "lint": "uv run --locked ruff check && uv run --locked ruff format --check && uv run --locked mypy",
    "test": "uv run --locked pytest",
    "mutate": "uv run --locked cosmic-ray init cosmic-ray.toml mutantes.sqlite --force && uv run --locked cosmic-ray exec cosmic-ray.toml mutantes.sqlite && uv run --locked cr-rate mutantes.sqlite --fail-over 20",
    "build": ""
  },
  "paths": {
    "src": "src",
    "tests": "tests"
  },
  "ui": {
    "paths": [
      "src/actas/panel/estatico"
    ],
    "routes": [
      "/",
      "/reuniones/00000000-0000-4000-8000-000000000005",
      "/reuniones/00000000-0000-4000-8000-000000000004",
      "/reuniones/00000000-0000-4000-8000-000000000017",
      "/reuniones/00000000-0000-4000-8000-000000000001",
      "/buscar?q=presupuesto",
      "/buscar",
      "/grabar",
      "/salas",
      "/salas/nueva",
      "/salas/5a1a0000-0000-4000-8000-000000000001",
      "/salas/5a1a0000-0000-4000-8000-000000000001/clave",
      "/programacion",
      "/reuniones/00000000-0000-4000-8000-000000000002",
      "/reuniones/00000000-0000-4000-8000-000000000002/modificar",
      "/reuniones/00000000-0000-4000-8000-000000000002/cancelar",
      "/reuniones/00000000-0000-4000-8000-000000000005/eliminar",
      "/papelera",
      "/reuniones/00000000-0000-4000-8000-0000000000aa",
      "/reuniones/00000000-0000-4000-8000-000000000005/compartir",
      "/reuniones/00000000-0000-4000-8000-000000000005/compartir?que=transcripcion&que=enlace_sala&socio=pablo&socio=roberto"
    ],
    "themes": [
      "light",
      "dark"
    ]
  },
  "mutation": {
    "threshold": 0.8,
    "targets": []
  },
  "api": true,
  "mcp": {
    "exception": {
      "until": "2026-12-20",
      "reason": "el servidor MCP ya existe; faltan su catalogo.json de capas y el test del catálogo",
      "issue": "Cenit-Digital/ActasReuniones#33"
    }
  },
  "rules": {
    "require_tests_to_close": true,
    "require_mutation_to_close": false
  }
}
